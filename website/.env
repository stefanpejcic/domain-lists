# used for sitemap to build absolute urls
SITE_URL="https://yourdomain.com"

# used to downlaod zones from ICANN CZDS
USERNAME=""
PASSWORD=""

# used to send email alerts when download/parse fails
EMAIL=""

# base URL of the self-hosted Certificate Transparency API (used by
# scripts/generate_live_domains.py), e.g. https://ct.example.com
CT_LOGS=""

# Google Safe Browsing v4 API key (used by scripts/generate_threat_matches.py).
# Optional - the safebrowsing source is skipped entirely if unset.
G_API_KEY=""
